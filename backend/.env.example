# Firebase Admin project configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Storage bucket for private generated lesson-note images.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Use either local Application Default Credentials, or uncomment and set this
# to a secure service-account JSON path outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure-path/firebase-admin.json

# Server-side AI usage controls (global across users; enforced transactionally).
AI_DAILY_REQUEST_LIMIT=200
AI_MONTHLY_ESTIMATED_COST_LIMIT_USD=25
AI_MAX_OUTPUT_TOKENS=8192
AI_TEST_ENDPOINT_ENABLED=false

# Enable Gemini Live voice teaching. The browser receives only a one-use,
# short-lived Gemini token; the long-lived API key stays on the backend.
GEMINI_LIVE_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.8-live
# Conservative cost reservation per Live session. Review when changing models.
GEMINI_LIVE_SESSION_COST_RESERVE_USD=2.00

# Gemini 3.8 Flash introductory per-million-token rates (published through
# 2026-12-31). Review after that date and override both rates when changing
# models or when Google changes pricing. Unknown model pricing fails closed.
GEMINI_INPUT_PRICE_PER_MILLION_USD=0.75
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=3.75
GEMINI_SEARCH_PRICE_PER_THOUSAND_USD=14
GEMINI_NOTES_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_NOTES_IMAGE_SIZE=2K
# Conservative per-image reservation used by the shared monthly AI cost limit.
GEMINI_NOTES_IMAGE_COST_USD=0.18
